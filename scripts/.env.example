# ============================================================
# 复制本文件为 .env 后填写密钥；或使用环境变量 / macOS Keychain
# 密钥文件 .env 已被 .gitignore 忽略，绝不能提交！
# macOS Keychain: security add-generic-password -s vision-fallback -a <键名> -w <密钥>
# ============================================================

# --- 通用参数 ---
VISION_MAX_RETRIES=1
VISION_RETRY_DELAY_MS=3000
VISION_TIMEOUT_MS=25000
VISION_PROVIDER_ORDER=agnes25,glm4v,cloudflare,agnes,glm,glm-thinking
VISION_COMPRESS_MIN_BYTES=1572864
VISION_COMPRESS_MAX_EDGE=1280

# --- 智谱 GLM（免费）---
VISION_API_KEY=your_zhipu_api_key
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v-flash
GLM_THINKING_MODEL=glm-4.1v-thinking-flash
GLM4V_MODEL=glm-4v-flash

# --- DashScope 千问（付费可选）---
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-max
QWEN3_MODEL=qwen3-vl-plus

# --- Cloudflare Workers AI（免费额度）---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# --- Agnes（OpenAI 兼容聚合平台）---
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES25_MODEL=agnes-2.5-flash
